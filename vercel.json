{
    "version": 2,
    "builds": [
      { 
        "src": "api.js", 
        "use": "@vercel/node" 
      }
    ],
    "routes": [
      { 
        "src": "(.*)", 
        "dest": "api.js", 
        "methods": ["GET", "POST", "PUT", "DELETE", "OPTIONS"], 
        "headers": { 
          "Access-Control-Allow-Origin": "*"
      } 
      }
    ]
  }